# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Your key from https://puntersedge.online/api (free tier, no card). Server-side only.
PUNTERSEDGE_API_KEY=replace-with-your-key

# Which races to show. country is an ISO code the API accepts (AU, NZ, GB, IE, ZA).
PE_COUNTRY=AU
# Races per refresh. Up to 20 races costs the least per call on keys issued from 2026-09-22.
PE_NUM_RACES=20

# Seconds between upstream refreshes, shared by every visitor. Minimum 20.
# Credits per month ~= 2 x (3600 / PE_POLL_SECONDS) x hours of racing a day x 30. See README.
PE_POLL_SECONDS=60
# Stop refreshing when nobody has viewed the page for this many seconds (saves credits overnight).
PE_IDLE_SECONDS=600

PORT=8080
# 1 = serve the bundled synthetic fixture instead of calling the API (no key needed).
PE_FIXTURES=0
