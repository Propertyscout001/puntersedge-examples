# Copy to .env (git-ignored) or export these in your shell. Never commit a real key.
PUNTERSEDGE_API_KEY=replace-with-your-key
# Which day to sample (Australian Eastern date). Empty = the most recent full day.
PE_SAMPLE_DATE=
PE_COUNTRY=AU
# horse, greyhound or harness; empty = all three
PE_CATEGORY=horse
# Hard cap on API calls for one run of the notebook.
PE_MAX_CALLS=40
# 1 = run on the bundled synthetic fixtures (no key, no network).
PE_USE_FIXTURES=0
