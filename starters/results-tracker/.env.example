# Copy to .env (git-ignored) or export in your shell. Never commit real secrets.
PUNTERSEDGE_API_KEY=replace-with-your-key
# Where the tracker keeps state (which results it has already reported). Safe to delete to start over.
PE_DB=results-tracker.sqlite3
# Seconds between results polls (minimum 60) and a hard cap on requests per run.
PE_POLL_SECONDS=120
PE_MAX_REQUESTS=300
# Only for webhook_receiver.py (race.result webhooks are on Plus and above): the secret returned once
# when you created the subscription, and the previous one during a rotation.
PE_WEBHOOK_SECRET=
PE_WEBHOOK_SECRET_PREVIOUS=
PE_WEBHOOK_PORT=8787
